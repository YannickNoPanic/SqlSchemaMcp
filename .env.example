# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Host/container port. Change this if 5101 is already in use on the server.
MCP_PORT=5101

# "poc" and "azure" below are just example database keys (see docker-compose.yml) — rename
# them to whatever fits your own setup, or add more by adding another
# SQLMCP_SqlServer__Databases__<yourkey> line in docker-compose.yml plus its own env var here.
SQLMCP_POC_CONNECTION_STRING=Server=YOUR_SERVER;Database=YOUR_POC_DB;User Id=sqlschema_ro;Password=CHANGE_ME;TrustServerCertificate=true;
SQLMCP_AZURE_CONNECTION_STRING=Server=YOUR_SERVER.database.windows.net;Database=YOUR_AZURE_DB;Authentication=Active Directory Default;
# Values must be raw connection strings. Do not prefix them with another NAME= assignment.
#
# SQL Server is the complete engine. PostgreSQL and MariaDB can be represented by
# object-shaped entries under SqlServer:Databases in appsettings.json; they currently
# support schema browsing and shared snapshot-backed analysis.

# Set to true only if your configured login(s) have write permissions and you accept that
# risk (see docs/security-posture.md). Leave unset/false to keep the startup gate strict.
SQLMCP_ALLOW_WRITABLE_LOGIN=false
