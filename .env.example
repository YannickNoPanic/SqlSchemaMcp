# Copy to .env and fill in the values for this machine or deployment.
# .env is gitignored. Do not commit real server names, usernames, or passwords.

# Docker/HTTP runtime override. For Docker this must be 0.0.0.0 so the container port is reachable.
# For local non-Docker HTTP mode you may remove this line to use appsettings' localhost default.
SQLMCP_Mcp__BindAddress=0.0.0.0
SQLMCP_Mcp__Port=5101

# Audit defaults for Docker/shared HTTP mode. Local appsettings defaults are enough for normal stdio use.
SQLMCP_Audit__Enabled=true
SQLMCP_Audit__Path=/data/audit-log.jsonl

# Startup permission gate. Leave strict unless you deliberately accept writable SQL Server logins.
SQLMCP_Security__VerifyLoginsAtStartup=true
SQLMCP_Security__AllowWritableLogin=false

# SQL Server database. Bare string entries are SQL Server by default.
SQLMCP_SqlServer__Databases__poc=Server=YOUR_SERVER;Database=YOUR_POC_DB;User Id=sqlschema_ro;Password=CHANGE_ME;TrustServerCertificate=true;

# PostgreSQL database. Object-shaped entries need Engine + ConnectionString.
SQLMCP_SqlServer__Databases__postgres_reporting__Engine=Postgres
SQLMCP_SqlServer__Databases__postgres_reporting__ConnectionString=Host=YOUR_HOST;Database=YOUR_DB;Username=readonly;Password=CHANGE_ME

# MariaDB database. Add SslMode=Disabled only for local/test containers that do not support SSL.
SQLMCP_SqlServer__Databases__mariadb_legacy__Engine=MariaDb
SQLMCP_SqlServer__Databases__mariadb_legacy__ConnectionString=Server=YOUR_HOST;Database=YOUR_DB;User ID=readonly;Password=CHANGE_ME
