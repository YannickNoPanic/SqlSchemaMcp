<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlSchemaMcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sql-schema-mcp</ToolCommandName>
    <PackageId>SqlSchemaMcp</PackageId>
    <Authors>SqlSchemaMcp contributors</Authors>
    <Description>Read-only multi-engine MCP server for SQL Server, PostgreSQL, and MariaDB schema analysis.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;sql;schema;sqlserver;postgres;mariadb</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SqlSchemaMcp.Tests\**" />
    <Compile Remove="SqlSchemaMcp.Abstractions\**" />
    <Compile Remove="SqlSchemaMcp.SqlServer\**" />
    <Compile Remove="SqlSchemaMcp.Postgres\**" />
    <Compile Remove="SqlSchemaMcp.MariaDb\**" />
    <Content Remove="SqlSchemaMcp.Tests\**" />
    <Content Remove="SqlSchemaMcp.Abstractions\**" />
    <Content Remove="SqlSchemaMcp.SqlServer\**" />
    <Content Remove="SqlSchemaMcp.Postgres\**" />
    <Content Remove="SqlSchemaMcp.MariaDb\**" />
    <EmbeddedResource Remove="SqlSchemaMcp.Tests\**" />
    <EmbeddedResource Remove="SqlSchemaMcp.Abstractions\**" />
    <EmbeddedResource Remove="SqlSchemaMcp.SqlServer\**" />
    <EmbeddedResource Remove="SqlSchemaMcp.Postgres\**" />
    <EmbeddedResource Remove="SqlSchemaMcp.MariaDb\**" />
    <None Remove="SqlSchemaMcp.Tests\**" />
    <None Remove="SqlSchemaMcp.Abstractions\**" />
    <None Remove="SqlSchemaMcp.SqlServer\**" />
    <None Remove="SqlSchemaMcp.Postgres\**" />
    <None Remove="SqlSchemaMcp.MariaDb\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SqlSchemaMcp.Abstractions\SqlSchemaMcp.Abstractions.csproj" />
    <ProjectReference Include="SqlSchemaMcp.SqlServer\SqlSchemaMcp.SqlServer.csproj" />
    <ProjectReference Include="SqlSchemaMcp.Postgres\SqlSchemaMcp.Postgres.csproj" />
    <ProjectReference Include="SqlSchemaMcp.MariaDb\SqlSchemaMcp.MariaDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
